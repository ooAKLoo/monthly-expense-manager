DASHSCOPE_API_KEY=sk-your-local-key
DASHSCOPE_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_LLM_MODEL=qwen3.7-plus
DASHSCOPE_VISION_MODEL=qwen-vl-plus
DASHSCOPE_MULTIMODAL_MODEL=qwen-vl-plus
API_PORT=8788
API_HOST=127.0.0.1
EXPENSE_DATA_DIR=./data

# Optional Aliyun OSS. Leave DASHSCOPE_USE_OSS=false to send image data directly.
DASHSCOPE_USE_OSS=false
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PREFIX=monthly-expenses
